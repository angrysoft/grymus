{
	"name": "grymus",
	"version": "0.1.0",
	"devDependencies": {
		"@tailwindcss/typography": "^0.5.15",
		"tailwindcss": "^3.4.16",
		"typescript": "^5.7.2"
	},
	"scripts": {
		"watch": "npx tailwindcss -i ./tailwind.css -o ./grymus/style.css --watch",
